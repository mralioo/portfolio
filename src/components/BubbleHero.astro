---
import ExperienceItemCmp from './ExperienceItem.astro';
import ProjectCard from './ProjectCard.astro';
import type { CollectionEntry } from 'astro:content';
import type { ExperienceItem } from '../data/experience';
import type { SkillGroup } from '../data/skills';
import { withBase } from '../lib/url';

interface Props {
  profile: {
    name: string;
    role: string;
    location: string;
    motto: string;
    heroDescription: string;
    email: string;
    resumeUrl: string;
    calendlyUrl: string;
  };
  experiencePreview: ExperienceItem[];
  projects: CollectionEntry<'projects'>[];
  skillGroups: SkillGroup[];
  postsPreview: CollectionEntry<'blog'>[];
}

const { profile, experiencePreview, projects, skillGroups, postsPreview } = Astro.props as Props;

// id, kicker number (matches the section numbering below), label, jump target
const bubbles = [
  { id: 'about', kicker: '01', label: 'About', jump: '#about' },
  { id: 'experience', kicker: '02', label: 'Experience', jump: '#experience' },
  { id: 'projects', kicker: '04', label: 'Projects', jump: '#projects' },
  { id: 'skills', kicker: '05', label: 'Skills', jump: '#skills' },
  { id: 'blog', kicker: '06', label: 'Blog', jump: '#blog-teaser' },
  { id: 'contact', kicker: '08', label: 'Contact', jump: '#contact' },
];
---
<section class="bubble-hero">
  <canvas data-particles aria-hidden="true"></canvas>

  <div class="wrap bubble-hero-head">
    <p class="hero-eyebrow">// {profile.role}</p>
    <h1>{profile.name}</h1>
    <p class="bubble-hint text-dim">Hover a bubble, click to open it.</p>
  </div>

  <div class="bubble-field" data-bubble-field>
    {bubbles.map((b) => (
      <button
        type="button"
        class="bubble"
        data-bubble={b.id}
        aria-haspopup="dialog"
        aria-label={`Open ${b.label}`}
      >
        <span class="bubble-kicker">{b.kicker}</span>
        <span class="bubble-label">{b.label}</span>
      </button>
    ))}
  </div>

  <a class="scroll-cue" href="#about" aria-label="Scroll to content">↓</a>

  <!-- Overlay: one panel per bubble, toggled by bubbles.js. A condensed
       preview of that section — full detail lives further down the page,
       reached by scrolling, not duplicated here. -->
  <div class="bubble-backdrop" data-bubble-backdrop hidden></div>
  <div class="bubble-overlay" data-bubble-overlay role="dialog" aria-modal="true" hidden>
    <button type="button" class="bubble-close" data-bubble-close aria-label="Close">✕</button>
    <div class="bubble-panel-content" data-bubble-content>

      <div class="bubble-panel" data-panel="about">
        <h3>About</h3>
        <p class="motto">&ldquo;{profile.motto}&rdquo;</p>
        <p>{profile.heroDescription}</p>
        <p class="text-dim">Based in {profile.location}.</p>
      </div>

      <div class="bubble-panel" data-panel="experience">
        <h3>Experience</h3>
        <div class="timeline">
          {experiencePreview.map((item) => <ExperienceItemCmp item={item} />)}
        </div>
      </div>

      <div class="bubble-panel" data-panel="projects">
        <h3>Projects</h3>
        <div class="grid">
          {projects.map((p) => (
            <ProjectCard
              title={p.data.title}
              summary={p.data.summary}
              stack={p.data.stack}
              repo={p.data.repo}
              demo={p.data.demo}
              href={withBase(`/projects/${p.slug}`)}
            />
          ))}
        </div>
      </div>

      <div class="bubble-panel" data-panel="skills">
        <h3>Skills</h3>
        <div class="grid">
          {skillGroups.map((g) => (
            <div class="skill-group">
              <h3>{g.label}</h3>
              <div class="tag-row">
                {g.items.map((i) => <span class="tag">{i}</span>)}
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="bubble-panel" data-panel="blog">
        <h3>From the blog</h3>
        <div class="post-list">
          {postsPreview.map((post) => (
            <a class="post-item" href={withBase(`/blog/${post.slug}`)}>
              <div>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </div>
              <span class="post-date">{post.data.date.toISOString().slice(0, 10)}</span>
            </a>
          ))}
        </div>
        <a class="bubble-jump" href={withBase('/blog')}>All posts →</a>
      </div>

      <div class="bubble-panel" data-panel="contact">
        <h3>Get in touch</h3>
        <p class="text-dim">Open to interesting roles and collaborations.</p>
        <div class="hero-actions">
          <a class="btn primary" href={`mailto:${profile.email}`}>Email me</a>
          <a class="btn" href={profile.calendlyUrl} target="_blank" rel="noreferrer">Schedule a call</a>
          <a class="btn" href={withBase(profile.resumeUrl)} target="_blank" rel="noreferrer">Resume (PDF)</a>
        </div>
      </div>

    </div>
  </div>
</section>
<script src="../scripts/hero-entry.js"></script>
