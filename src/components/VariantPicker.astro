---
// TEMPORARY design-review picker: switches the sidebar between the intro
// options in sidebarVariants.ts. Rendered only on the dev server or when the
// URL has ?review, so real visitors never see it. Delete after choosing.
import type { SidebarVariant } from '../data/sidebarVariants';

interface Props {
  variants: SidebarVariant[];
}
const { variants } = Astro.props as Props;
---
<aside class="vp" data-variant-picker hidden aria-label="Design review: sidebar options">
  <header>
    <strong>Design review</strong>
    <button type="button" class="vp-min" data-vp-min aria-label="Minimize">–</button>
  </header>
  <div class="vp-body">
    <p class="vp-hint">Pick a sidebar style. Keys <kbd>1</kbd>–<kbd>{variants.length}</kbd> also work.</p>
    <div class="vp-options" role="radiogroup" aria-label="Sidebar option">
      {variants.map((v, i) => (
        <button type="button" role="radio" aria-checked="false" data-vp-option={v.id}>
          <span class="vp-key">{v.id.toUpperCase()}</span>
          <span>
            <b>{v.name}</b>
            <small>{v.pitch}</small>
          </span>
        </button>
      ))}
    </div>
  </div>
</aside>

<style>
  .vp {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 60;
    width: min(340px, calc(100vw - 2rem));
    border: 1px solid var(--line);
    border-radius: 12px;
    background: color-mix(in srgb, var(--bg-sunk) 92%, transparent);
    backdrop-filter: blur(10px);
    box-shadow: 0 18px 40px -12px var(--shadow);
    font-size: 0.8rem;
  }

  /* phones: the floating persona avatar owns the bottom-right corner */
  @media (max-width: 1023px) {
    .vp {
      right: auto;
      left: 1rem;
    }
  }

  .vp[hidden] {
    display: none;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.55rem 0.8rem;
    border-bottom: 1px solid var(--line-soft);
    color: var(--text-strong);
  }

  header strong::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
    vertical-align: middle;
  }

  .vp-min {
    width: 26px;
    height: 26px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }

  .vp.is-min .vp-body {
    display: none;
  }

  .vp-body {
    padding: 0.7rem 0.8rem 0.8rem;
  }

  .vp-hint {
    margin: 0 0 0.6rem;
    color: var(--text-muted);
  }

  kbd {
    padding: 0 0.3rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    font-family: var(--mono);
    font-size: 0.7rem;
  }

  .vp-options {
    display: grid;
    gap: 0.4rem;
  }

  .vp-options button {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    width: 100%;
    padding: 0.55rem 0.65rem;
    border: 1px solid var(--line-soft);
    border-radius: 8px;
    background: transparent;
    color: var(--text);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
  }

  .vp-options button:hover {
    border-color: var(--line-strong);
  }

  .vp-options button[aria-checked='true'] {
    border-color: var(--accent);
    background: var(--accent-bg);
  }

  .vp-key {
    flex: none;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 6px;
    background: var(--line-soft);
    font-family: var(--mono);
    font-weight: 600;
    color: var(--accent);
  }

  .vp-options b {
    display: block;
    color: var(--text-strong);
    font-weight: 600;
  }

  .vp-options small {
    display: block;
    margin-top: 0.1rem;
    font-size: 0.72rem;
    line-height: 1.4;
    color: var(--text-muted);
  }
</style>

<script>
  const picker = document.querySelector<HTMLElement>('[data-variant-picker]');
  const params = new URLSearchParams(location.search);
  if (picker && (import.meta.env.DEV || params.has('review'))) {
    const root = document.documentElement;
    const options = Array.from(picker.querySelectorAll<HTMLButtonElement>('[data-vp-option]'));
    const sync = () => options.forEach((b) => b.setAttribute('aria-checked', String(b.dataset.vpOption === root.dataset.variant)));
    const choose = (id: string) => {
      root.dataset.variant = id;
      try {
        localStorage.setItem('sidebar-variant', id);
      } catch {}
      sync();
    };
    // ?review=c opens straight on an option
    const fromUrl = params.get('review');
    if (fromUrl && options.some((b) => b.dataset.vpOption === fromUrl)) choose(fromUrl);
    picker.hidden = false;
    // phones: start collapsed so the page stays readable
    if (window.innerWidth < 1024) picker.classList.add('is-min');
    sync();
    options.forEach((b) => b.addEventListener('click', () => choose(b.dataset.vpOption!)));
    picker.querySelector('[data-vp-min]')?.addEventListener('click', () => picker.classList.toggle('is-min'));
    document.addEventListener('keydown', (e) => {
      if (e.target instanceof HTMLElement && e.target.closest('input, textarea')) return;
      const i = Number(e.key) - 1;
      if (options[i]) choose(options[i].dataset.vpOption!);
    });
  }
</script>
