---
import Icon from './Icon.astro';
import { socials } from '../data/profile';
---
<footer class="site-footer">
  <ul class="socials" aria-label="Social media">
    {socials.map((s) => (
      <li>
        <a href={s.url} aria-label={s.label} target={s.url.startsWith('http') ? '_blank' : undefined} rel="noreferrer">
          <Icon name={s.icon} size={22} />
        </a>
      </li>
    ))}
  </ul>
  <p>
    Layout inspired by <a href="https://github.com/bchiang7" target="_blank" rel="noreferrer">Brittany Chiang</a>.
    Built with <a href="https://astro.build" target="_blank" rel="noreferrer">Astro</a>, set in Inter.
    &copy; {new Date().getFullYear()} Ali Alouane.
  </p>
</footer>
