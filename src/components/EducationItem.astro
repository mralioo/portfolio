---
import type { EducationItem } from '../data/education';
const { item } = Astro.props as { item: EducationItem };
---
<div class="timeline-item reveal">
  <div class="timeline-date">{item.start} – {item.end}</div>
  <h3>{item.degree}</h3>
  <div class="timeline-org">{item.org}</div>
  {item.detail && <p class="text-dim">{item.detail}</p>}
  {item.thesis && (
    <p class="text-dim">
      <strong>Thesis</strong> ({item.thesis.group}): {item.thesis.title}
    </p>
  )}
</div>
