---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import PersonaAvatar from '../components/PersonaAvatar.astro';
import Journey from '../components/Journey.astro';
import { experienceJourney, learningJourney } from '../lib/journey';
import ProjectCard from '../components/ProjectCard.astro';
import Lifecycle from '../components/Lifecycle.astro';
import BlogShowcase from '../components/BlogShowcase.astro';
import SkillExplorer from '../components/SkillExplorer.astro';
import type { UsageSource } from '../lib/tech';
import { profile, socials } from '../data/profile';
import { experience } from '../data/experience';
import { education, certificates } from '../data/education';
import { lifecycle, lifecycleLoop, skillGroups, languages, languagesPersona } from '../data/skills';
import { physicalAI } from '../data/extras';
import { courses } from '../data/learning';
import { sections, blocks } from '../data/sections';
import { inlineMd } from '../lib/inline-md';
import { withBase } from '../lib/url';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

// Where each technology shows up, for the Skills explorer's "used in" drawer.
const usageSources: UsageSource[] = [
  ...experience.map((e) => ({ label: e.org, detail: e.role, href: '#experience', terms: e.stack, text: e.bullets.join(' ') })),
  ...projects.map((p) => ({ label: p.data.title, detail: 'Project', href: withBase(`/projects/${p.slug}`), terms: p.data.stack, text: p.data.summary })),
  ...lifecycle.map((l) => ({ label: `Stage ${l.step}`, detail: l.short || l.title, href: '#skills', terms: l.tools, text: l.pitch })),
];

// Section order, labels and visibility come from content/sections.json.
const visible = sections.filter((s) => s.visible);
const show = (key: keyof typeof blocks) => blocks[key].visible;
---
<BaseLayout home>
  <div class="layout">
    <header class="sidebar" data-lenis-prevent>
      <div class="sidebar-top">
        <div class="identity">
          <PersonaAvatar />
          <p class="persona-label" data-persona-text></p>
        </div>
        <h1 class="name"><a href={withBase('/')}>{profile.name}</a></h1>

        <div class="intro">
          <h2 class="role">{profile.role}</h2>
          <div class="statement">
            {profile.intro.map((line) => <p set:html={inlineMd(line)} />)}
          </div>
          {profile.quote && (
            <blockquote class="intro-quote">
              <p>{profile.quote}</p>
            </blockquote>
          )}
        </div>

        {profile.status && <p class="status"><span class="pulse-dot" aria-hidden="true"></span>{profile.status}</p>}

        <div class="contact-row">
          {profile.email && <a class="btn primary" href={`mailto:${profile.email}`}>Get in touch</a>}
          {profile.resumeUrl && <a class="btn" href={withBase(profile.resumeUrl)} target="_blank" rel="noreferrer">Resume ↗</a>}
          <ul class="socials" aria-label="Social media">
            {socials.map((s) => (
              <li>
                <a href={s.url} aria-label={s.label} target={s.url.startsWith('http') ? '_blank' : undefined} rel="noreferrer">
                  <Icon name={s.icon} size={20} />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

    </header>

    <main id="content" class="content">
      {visible.map((s, i) => (
        <section id={s.id} class={`sec-${s.id}`} data-section data-persona={s.persona} aria-label={s.label}>
          <header class="sec-head reveal" data-heading={s.headingStyle}>
            <p class="sec-kicker">
              <span class="sec-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="sec-rule" aria-hidden="true"></span>
              <span>{s.label}</span>
            </p>
            <h2 class="sec-title">{s.title || s.label}</h2>
            {s.lead && <p class="sec-lead" set:html={inlineMd(s.lead)} />}
          </header>

          {s.id === 'about' && (
            <>
              {profile.about.map((para) => <p class="reveal" set:html={inlineMd(para)} />)}
              {show('motto') && profile.motto && (
                <figure class="motto reveal">
                  <span class="motto-mark" aria-hidden="true">&ldquo;</span>
                  <blockquote><p>{profile.motto}</p></blockquote>
                  <figcaption>my rule of thumb</figcaption>
                </figure>
              )}
            </>
          )}

          {s.id === 'skills' && (
            <>
              <Lifecycle stages={lifecycle} loop={lifecycleLoop} />
              {show('stack') && blocks.stack.title && (
                <header class="sub-head reveal">
                  <h3>{blocks.stack.title}</h3>
                  {blocks.stack.kicker && <p>{blocks.stack.kicker}</p>}
                </header>
              )}
              {show('stack') && <SkillExplorer groups={skillGroups} languages={languages} languagesPersona={languagesPersona} sources={usageSources} />}
            </>
          )}

          {s.id === 'experience' && (
            <>
              <Journey items={experienceJourney(experience)} label="Work experience timeline" />
              {show('resumeLink') && profile.resumeUrl && (
                <a class="more-link reveal" href={withBase(profile.resumeUrl)} target="_blank" rel="noreferrer">
                  {blocks.resumeLink.title} <span class="arrow" aria-hidden="true">→</span>
                </a>
              )}
            </>
          )}

          {s.id === 'projects' && (
            <>
              <ul class="entries">
                {projects.map((p) => (
                  <ProjectCard
                    title={p.data.title}
                    summary={p.data.summary}
                    stack={p.data.stack}
                    repo={p.data.repo}
                    demo={p.data.demo}
                    badge={p.data.badge}
                    image={p.data.image}
                    href={withBase(`/projects/${p.slug}`)}
                  />
                ))}
              </ul>

              {show('githubLink') && profile.github && (
                <a class="more-link reveal" href={profile.github} target="_blank" rel="noreferrer">
                  {blocks.githubLink.title} <span class="arrow" aria-hidden="true">→</span>
                </a>
              )}
            </>
          )}

          {s.id === 'lab' && (
            <>
              <div class="lab reveal">
                {physicalAI.status && <p class="badge live"><span class="pulse-dot" aria-hidden="true"></span>{physicalAI.status}</p>}
                <h3>{physicalAI.title}</h3>
                <p>{physicalAI.summary}</p>
                {physicalAI.tracks.length > 0 && (
                  <div class="lab-tracks">
                    {physicalAI.tracks.map((t) => (
                      <div>
                        <h4>{t.title}</h4>
                        <ul>{t.items.map((i) => <li>{i}</li>)}</ul>
                      </div>
                    ))}
                  </div>
                )}
                <img class="lab-img" src={withBase('/projects/robotic-arm.svg')} alt="" loading="lazy" />
              </div>
            </>
          )}

          {s.id === 'learning' && (
            <Journey
              items={learningJourney(education, certificates, courses, {
                education: show('education'),
                certificates: show('certificates'),
                courses: show('courses'),
              })}
              label="Education, certificates and courses timeline"
            />
          )}

          {s.id === 'writing' && (
            <>
              <BlogShowcase posts={posts} />
              {show('allPosts') && (
                <a class="more-link reveal" href={withBase('/blog')}>{blocks.allPosts.title} <span class="arrow" aria-hidden="true">→</span></a>
              )}
            </>
          )}
        </section>
      ))}

      <Footer />
    </main>
  </div>
  <nav class="section-dock" aria-label="Sections" data-section-dock>
    <span class="dock-arc" aria-hidden="true"></span>
    <span class="dock-ticks" aria-hidden="true"></span>
    <span class="dock-pin" aria-hidden="true"></span>
    <ul>
      {visible.map((s, i) => (
        <li>
          <a href={`#${s.id}`} data-nav-link={s.id}>
            <span class="dock-label">{s.label}</span>
            <span class="dock-num">{String(i + 1).padStart(2, '0')}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <PersonaAvatar variant="float" />
</BaseLayout>
<script src="../scripts/home.js"></script>
<script src="../scripts/persona.js"></script>
